{
  "name": "nf2-intellisense",
  "displayName": "NF2 Style Intellisense",
  "description": "Proporciona intellisense para los estilos del tema NF2",
  "version": "0.2.3",
  "icon": "assets/icons/icon-128x128.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nf2-intellisense.openDocumentation",
        "title": "NF2: Documentación en línea"
      },
      {
        "command": "nf2-intellisense.selectTheme",
        "title": "NF2: Seleccionar tema"
      },
      {
        "command": "nf2-intellisense.clearCache",
        "title": "NF2: Limpiar caché"
      },
      {
        "command": "nf2-intellisense.showLogs",
        "title": "NF2: Mostrar logs"
      }
    ],
    "configuration": {
      "title": "NF2 Style Intellisense",
      "properties": {
        "nf2-intellisense.enable": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar/deshabilitar la extensión NF2 Style Intellisense"
        },
        "nf2-intellisense.theme": {
          "type": "string",
          "default": "GSS",
          "enum": [
            "GSS",
            "Prevenet",
            "Intermediarios",
            "Rural"
          ],
          "enumDescriptions": [
            "GSS - Grupo Sancor Seguros",
            "Prevenet - Medicina prepaga GSS",
            "Intermediarios - Portal para productores",
            "Rural - Agroseguro"
          ],
          "description": "Tema de NF2 a utilizar"
        },
        "nf2-intellisense.logLevel": {
          "type": "string",
          "default": "INFO",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ],
          "description": "Nivel de log para la extensión"
        },
        "nf2-intellisense.useColoredLogs": {
          "type": "boolean",
          "default": true,
          "description": "Activar colores en los mensajes de log (azul para INFO, verde para SUCCESS, naranja para WARNING, rojo para ERROR)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "glob": "^11.0.2",
    "mocha": "^11.2.2",
    "typescript": "^5.8.3",
    "vscode-test": "^1.5.2"
  },
  "dependencies": {
    "css": "^3.0.0",
    "vscode-languageclient": "^9.0.1"
  },
  "publisher": "gss-team",
  "repository": {
    "type": "git",
    "url": "https://github.com/gss-team/nf2-intellisense.git"
  },
  "keywords": [
    "css",
    "intellisense",
    "html",
    "nf2",
    "autocomplete",
    "vue"
  ],
  "author": "GSS Team",
  "license": "MIT"
}
